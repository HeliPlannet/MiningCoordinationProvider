# apollogix-dev MCP server configuration
# SSH alias resolved from ~/.ssh/config (host, port, user, IdentityFile).
APOLLOGIX_DEV_SSH_HOST=apollogix_dev

# Layer 2 of scope resolution: the configured default, used when the MCP call
# passes no patterns or its patterns match nothing.
# Comma-separated globs matched against the compose service name, falling back
# to the container name. Leaving this empty is treated as invalid, not as
# "scan everything": the server then falls back to the hardcoded tms-*,fms-*.
APOLLOGIX_DEV_CONTAINER_PATTERNS=fms-*,tms-*,postgres16,kafka,debezium-connect

# Host-side HTTP probe
APOLLOGIX_DEV_DEFAULT_PROBE_PATH=/actuator/health
# Per-service overrides: svc=/path,svc2=/other
APOLLOGIX_DEV_PROBE_PATHS=ff-web=/,tms-web=/,apollogix-web=/,apl-blog-cms=/,kibana=/api/status,elasticsearch=/_cluster/health,es-node-1=/_cluster/health,apollogix-cdc-elasticsearch=/,connect=/,debezium-connect=/,elasticvue=/

# Timeouts and limits
APOLLOGIX_DEV_TIMEOUT_SEC=30
APOLLOGIX_DEV_PROBE_TIMEOUT_SEC=5
APOLLOGIX_DEV_EVENT_BUFFER=2000
APOLLOGIX_DEV_MAX_OUTPUT_BYTES=262144

# Disk thresholds (percent used on the worst mount)
APOLLOGIX_DEV_DISK_WARN_PCT=85
APOLLOGIX_DEV_DISK_CRIT_PCT=90
